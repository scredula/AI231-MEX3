# ==== LLM ====
OPENROUTER_API_KEY=sk-or-...
# Fast conversational model (low latency, used for live chat)
FAST_MODEL=google/gemini-2.5-flash
# Stronger model used by the background coding agent
CODING_MODEL=anthropic/claude-sonnet-4

# ==== ASR (speech-to-text) ====
# Provider used by the ASR MCP server: deepgram | openai
ASR_PROVIDER=deepgram
ASR_API_KEY=your-asr-key
# Optional: override provider model
ASR_MODEL=nova-3

# ==== TTS (text-to-speech) ====
# Provider: deepgram (recommended — reuses ASR_API_KEY, Aura-2 voices) | elevenlabs (paid
# plan required for library voices via API) | openai
TTS_PROVIDER=deepgram
TTS_API_KEY=                       # only for elevenlabs/openai; Deepgram TTS uses ASR_API_KEY
TTS_MODEL=aura-2-thalia-en         # deepgram: aura voice name; elevenlabs: model id
TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # elevenlabs only

# ==== GitHub (only needed for publishing websites) ====
GITHUB_TOKEN=

# ==== Audio devices (Pi local transport) ====
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# ==== Servers / runtime ====
TASKS_DB_PATH=data/tasks.json
WORKSPACE_DIR=workspace
MCP_ASR_PORT=8931
MCP_TTS_PORT=8932
MCP_TASK_PORT=8933
MCP_TOOLS_PORT=8934
DASHBOARD_PORT=8900
# Seconds of silence before the agent assumes you finished speaking.
# 0.2 = default (aggressive); 0.8 = more patient with mid-sentence pauses.
TURN_STOP_SECS=0.8
VAD_CONFIDENCE=0.75                # raise if background noise triggers speech (0..1)
VAD_START_SECS=0.3                 # voice must persist this long before speech starts
VAD_MIN_VOLUME=0.6                 # faint noise floor (0..1)
# Echo handling — pick ONE (default: detector)
MIC_GATE_DURING_TTS=0              # 1 = mute mic while bot speaks (kills barge-in too)
MIC_GATE_TAIL_SECS=0.6             # mic-gate tail (only used when MIC_GATE_DURING_TTS=1)

# Echo detector (default): mic stays OPEN (barge-in works); each speech burst is
# cross-correlated against recently-played TTS audio — echo is suppressed, real
# speech passes. Plus a transcript backstop for late reverb.
ECHO_DETECTOR=1
ECHO_CORR_THRESHOLD=0.32           # raise if echo still slips through (0..1)
ECHO_DECISION_WINDOW=2.0           # correlate if TTS played within this many seconds
ECHO_TEXT_WINDOW=4.0               # transcript backstop window after bot speech (s)
ECHO_TEXT_SIMILARITY=0.65          # fuzzy-match threshold for the backstop
ECHO_DECIDE_MS=400                 # mic audio held before an echo/real decision
ECHO_SILENCE_RMS=0.0004             # speech-level floor (raise if room hum trips it)
ECHO_SILENCE_MS=150
ECHO_SPEC_THRESHOLD=0.80          # timbre vote: echo shares the TTS voice's spectrum                # silence that resets the detector


# Telegram messaging (get a token from @BotFather; chat id = your user chat)
TELEGRAM_BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE
TELEGRAM_CHAT_ID=1385837357

# Reasoning models: exclude thinking tokens from spoken content (OpenRouter).
# REASONING_EFFORT: low|medium|high (or 0-100 on some providers); empty = omit.
REASONING_EXCLUDE=1
#REASONING_EFFORT=low
LOG_LEVEL=INFO
